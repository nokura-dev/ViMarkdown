<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.3.0-dev.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Avalonia 11 exposes stream font creation only through its unstable platform API. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <D2Runtime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</D2Runtime>
    <D2Runtime Condition="'$(D2Runtime)' == ''">$(NETCoreSdkRuntimeIdentifier)</D2Runtime>
    <ApplicationIcon>Assets/ViMarkdown.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/ViMarkdown.png" />
    <EmbeddedResource Include="../../README.md" LogicalName="ViMarkdown.InitialPages.README.md" />
    <EmbeddedResource Include="../../docs/markdown-syntax-sample.md" LogicalName="ViMarkdown.InitialPages.MarkdownSample.md" />
    <Content Include="Assets/Fonts/MigMix1M/*.ttf" Link="Fonts/MigMix1M/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/Fonts/MigMix1M/**/*" Exclude="Assets/Fonts/MigMix1M/*.ttf"
             Link="Licenses/MigMix1M/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../tools/d2/runtime/$(D2Runtime)/**/*" Link="Tools/D2/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../tools/d2/licenses/**/*" Link="Licenses/D2/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>
